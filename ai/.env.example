# AI Service 환경변수 예시
# 복사해서 사용: cp .env.example .env
# .env 는 커밋하지 않는다.

APP_ENV=local
LOG_LEVEL=INFO

# contracts 디렉터리 경로. 저장소에서 실행하면 비워둬도 자동으로 찾는다.
# CONTRACTS_DIR=/app/contracts

# true면 Gemini를 호출하지 않고 샘플 ReportDocument를 반환한다. 운영에서는 false여야 한다.
MOCK_REPORT=true

# Backend와 AI Service 사이의 내부 요청 인증 토큰. 운영에서는 필수다.
AI_INTERNAL_TOKEN=

# Gemini 호출에 사용하는 AI Service 서버 키. 운영에서는 필수다.
GEMINI_API_KEY=
GEMINI_MAX_RETRIES=2
# 서버 키로 실행하는 기본 모델. 무료 티어 우선 모델만 허용한다.
GEMINI_MODEL=gemini-3.5-flash-lite
# 사용자 API Key(X-Provider-Api-Key)로 선택할 수 있는 모델 allowlist. Backend ai.models.allowlist와 맞춘다.
# GEMINI_ALLOWED_MODELS=["gemini-3.5-flash-lite","gemini-3.5-flash","gemini-3.7-flash"]
# 사용자 API Key 검증 호출(모델 목록 조회) 타임아웃.
CREDENTIAL_VERIFY_TIMEOUT_SECONDS=10
# Gemini 호출 1건의 타임아웃. 생성 1회는 (4 + 이미지 수)번 호출한다.
GEMINI_TIMEOUT_SECONDS=90
# 생성 요청 하나가 Gemini 호출에 쓸 수 있는 전체 시간.
# Backend의 AI_SERVICE_RESPONSE_TIMEOUT(기본 300초)보다 짧게 유지한다.
GENERATION_DEADLINE_SECONDS=240
# 이미지 1장당 Gemini 호출 1회다. 무료 티어 분당 요청 한도를 지키기 위해 제한한다.
MAX_ANALYZED_IMAGES=10
