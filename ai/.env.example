# AI Service 환경변수 예시
# 복사해서 사용: cp .env.example .env
# .env 는 커밋하지 않는다.

APP_ENV=local
LOG_LEVEL=INFO

# contracts 디렉터리 경로. 저장소에서 실행하면 비워둬도 자동으로 찾는다.
# CONTRACTS_DIR=/app/contracts

# true면 Gemini를 호출하지 않고 샘플 ReportDocument를 반환한다.
MOCK_REPORT=true

# 로컬 개발용. 운영 흐름에서는 Backend가 요청마다 사용자 키를 전달한다.
GEMINI_API_KEY=
GEMINI_MAX_RETRIES=2
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=300
