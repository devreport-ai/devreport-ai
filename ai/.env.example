# AI Service 환경변수 예시
# 복사해서 사용: cp .env.example .env
# .env 는 커밋하지 않는다.

APP_ENV=local
LOG_LEVEL=INFO

# contracts 디렉터리 경로. 저장소에서 실행하면 비워둬도 자동으로 찾는다.
# CONTRACTS_DIR=/app/contracts

# true면 Gemini를 호출하지 않고 샘플 ReportDocument를 반환한다.
MOCK_REPORT=true

# Gemini 호출에 사용하는 AI Service 서버 키. 사용자별 키 전달은 MVP 범위가 아니다.
GEMINI_API_KEY=
GEMINI_MAX_RETRIES=2
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=300
