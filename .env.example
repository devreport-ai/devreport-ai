# Application
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/devreport
DATABASE_USERNAME=devreport
DATABASE_PASSWORD=devreport
POSTGRES_PORT=5432
JWT_SECRET=
# 사용자 provider API Key 암호화 마스터 키(Base64 32바이트). 비우면 로컬에서만 임시 키를 쓴다.
# 생성: openssl rand -base64 32
AI_CREDENTIAL_MASTER_KEY=
AI_CREDENTIAL_KEY_VERSION=1
AUTH_REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_REFRESH_TOKEN_COOKIE_PATH=/api/auth
AUTH_REFRESH_TOKEN_COOKIE_SECURE=false
AUTH_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_RESPONSE_TIMEOUT=300s
AI_SERVICE_MOCK=false
AI_INTERNAL_TOKEN=
GEMINI_API_KEY=
# 서버 키로 실행하는 기본 모델. 무료 티어 우선 Gemini 3.5 Flash-Lite만 허용한다.
GEMINI_MODEL=gemini-3.5-flash-lite
# 사용자가 본인 키로 선택할 수 있는 모델은 backend application.yml(ai.models.allowlist)과
# AI Service GEMINI_ALLOWED_MODELS 에서 같은 값으로 관리한다.

# Redis - Optional
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
UPLOAD_PATH=./uploads
EXPORT_PATH=./generated-reports
