# Application
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8000

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/devreport
DATABASE_USERNAME=devreport
DATABASE_PASSWORD=devreport
POSTGRES_PORT=5432
JWT_SECRET=
AUTH_REFRESH_TOKEN_COOKIE_NAME=refresh_token
AUTH_REFRESH_TOKEN_COOKIE_PATH=/api/auth
AUTH_REFRESH_TOKEN_COOKIE_SECURE=false
AUTH_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PASSWORD_RESET_FROM=
PASSWORD_RESET_TOKEN_TTL=30m
RESEND_API_KEY=

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT=3s
AI_SERVICE_RESPONSE_TIMEOUT=300s
AI_SERVICE_MOCK=false
AI_INTERNAL_TOKEN=
GEMINI_API_KEY=
# AI Service는 무료 티어 우선 Gemini 3.5 Flash-Lite만 사용한다.
GEMINI_MODEL=gemini-3.5-flash-lite

# Redis - Optional
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
UPLOAD_PATH=./uploads
EXPORT_PATH=./generated-reports
