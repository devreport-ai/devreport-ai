# 프로덕션 환경변수 예시. 서버에서 .env.prod로 복사해 실제 값을 채운다.
# .env.prod는 절대 커밋하지 않는다.

# ── 공개 진입점 ───────────────────────────────────────────────────────────
# Caddy가 이 도메인으로 Let's Encrypt 인증서를 자동 발급한다.
# DNS A 레코드가 서버 공인 IP를 가리킨 뒤에 기동해야 발급에 성공한다.
PUBLIC_DOMAIN=devreport.example.com
ACME_EMAIL=admin@example.com

# ── 이미지 태그 ───────────────────────────────────────────────────────────
# 롤백할 수 있도록 latest 대신 커밋 SHA를 쓰는 것을 권장한다.
IMAGE_TAG=latest

# ── 시크릿 (openssl rand로 생성) ──────────────────────────────────────────
# openssl rand -base64 32
DATABASE_USERNAME=devreport
DATABASE_PASSWORD=
JWT_SECRET=
AI_INTERNAL_TOKEN=
# 사용자 provider API Key 암호화 마스터 키(Base64 32바이트). 비우면 Backend가 기동하지 않는다.
# 분실하면 저장된 사용자 키를 복호화할 수 없다. rotation은 docs/user-api-key-policy.md 참고.
AI_CREDENTIAL_MASTER_KEY=
AI_CREDENTIAL_KEY_VERSION=1
RESEND_API_KEY=

# ── 비밀번호 재설정 메일 ─────────────────────────────────────────────────
PUBLIC_APP_URL=https://devreport.example.com
PASSWORD_RESET_FROM=DevReport AI <no-reply@mail.example.com>

# ── Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# 서버 키로 실행하는 기본 모델. Backend application.yml 의 server-default 와 같아야 한다.
GEMINI_MODEL=gemini-3.5-flash-lite

# ── 로그 ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
