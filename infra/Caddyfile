{
	# 인증서 만료 경고를 받을 주소. 비워 두면 Let's Encrypt 계정이 익명으로 생성된다.
	email {$ACME_EMAIL}
}

# Frontend 정적 파일과 Backend API를 같은 Origin으로 제공한다.
# 이렇게 하면 CORS 설정과 preflight 자체가 필요 없다.
(app) {
	encode zstd gzip

	# 어떤 요청이 실패했는지 추적할 수 있어야 한다. 인증 헤더와 쿠키는 남기지 않는다.
	log {
		output stdout
		format json
		level INFO
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			# PDF 렌더와 AI 생성은 오래 걸리므로 기본 타임아웃으로는 끊긴다.
			transport http {
				response_header_timeout 310s
			}
		}
	}

	handle {
		root * /srv
		# SPA이므로 알 수 없는 경로는 index.html이 받아 라우팅한다.
		try_files {path} /index.html
		file_server
	}
}

{$PUBLIC_DOMAIN} {
	import app
}

# PDF 렌더용 내부 주소.
# Backend 컨테이너의 Chromium이 EXPORT_PRINT_URL로 여기에 접근한다.
# 공인 도메인을 거치지 않으므로 TLS 종료나 DNS 헤어핀 문제가 없다.
http://caddy {
	import app
}
